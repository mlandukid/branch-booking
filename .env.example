# Copy this file to .env to change the defaults. Docker Compose reads .env automatically.
# Nothing here is a secret. These are local development defaults. Never commit a real .env file.

# --- Used by docker compose ---
# Port of the application on your machine
APP_PORT=8081
# Port of the MailHog inbox on your machine
MAILHOG_PORT=8025
# Database password. The database is not reachable from outside the Docker network.
DB_PASSWORD=booking

# --- Backend settings, for running it outside Docker ---
DB_URL=jdbc:postgresql://localhost:5432/booking
DB_USER=booking
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@branchbooking.local
# Set to false to simulate email by writing it to the log
MAIL_ENABLED=true
# The address used in the private manage link in emails
PUBLIC_BASE_URL=http://localhost:8081
BOOKING_TIMEZONE=Africa/Johannesburg
# Appointments cannot be changed or cancelled this many hours before they start
CHANGE_CUTOFF_HOURS=2
# Bookings, with the customer name and email, are deleted this many days after the appointment
RETENTION_DAYS=90
# Set to false to switch off Swagger UI and the OpenAPI document
SWAGGER_ENABLED=true
# Set to any secret to switch on the branch admin API (X-Admin-Key header). Leave empty to keep it off.
ADMIN_API_KEY=